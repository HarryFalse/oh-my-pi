// Model-lineage compat for "xai"; regenerated from the frozen census using class taxonomy selectors.

class "xai" {
	// SuperGrok serves the >200K prompt tier at 2x the row's live list price
	// on both the API and OAuth surfaces; the multiplier form tracks
	// stencil.so price updates. Zero-cost subscription rows carry no tier.
	on "xai" "xai-oauth" {
		models "grok-4.3" "grok-4.5" "grok-4.6" "grok-build-0.1" "grok-4.20*" {
			long-context-cost {
				input-threshold 200000
				input-threshold-inclusive #true
				multiplier 2.0
			}
		}
	}
	on "aimlapi" "kilo" "nanogpt" "opencode-go" "opencode-zen" "venice" "vercel-ai-gateway" \
		"zenmux" {
		family "grok" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	on "cursor" "openrouter" "xai" "xai-oauth" {
		family "grok" {
			revision ">=0" {
				thinking-efforts "minimal" "low" "medium" "high"
			}
		}
	}
	// First-party xhigh-capable SKUs (grok-4.6, multi-agent) advertise xhigh.
	on "xai" "xai-oauth" {
		family "grok" {
			models "grok-4.6*" "grok-4.20-multi-agent*" {
				thinking-efforts "minimal" "low" "medium" "high" "xhigh"
			}
		}
	}
	// First-party Grok 4.7: https://docs.x.ai/developers/models/grok-4.7
	// https://docs.x.ai/developers/model-capabilities/text/reasoning
	// Grok 4.7 corrections override stale discovery capability metadata.
	// SuperGrok availability and matching metadata confirmed via /v1/models.
	on "xai" "xai-oauth" {
		models "grok-4.7*" {
			thinking-efforts "low" "medium" "high" "xhigh"
			thinking-default-level "high"
			thinking-requires-effort #true
			input-modalities "text" "image"
			limits-patch {
				context-window 500000
			}
			long-context-cost {
				input-threshold 200000
				input-threshold-inclusive #true
				multiplier 2.0
			}
		}
	}
	on "xai-oauth" {
		family "grok" {
			revision ">=0.1 <4.3" {
				supports-reasoning-effort #false
			}
		}
	}
	thinking-loop-guard "xai"
}
